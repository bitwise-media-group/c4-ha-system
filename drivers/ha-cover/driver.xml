				<type>STRING</type>
				<default></default>
				<readonly>true</readonly>
			</property>
			<property>
				<name>Entity Selector</name>
				<type>DYNAMIC_LIST</type>
				<readonly>false</readonly>
				<tooltip>Pick a cover entity discovered from Home Assistant (populated while the gateway is connected)</tooltip>
			</property>
			<property>
				<name>Entity ID</name>
				<type>STRING</type>
				<default></default>
				<readonly>false</readonly>
