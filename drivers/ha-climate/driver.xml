	</proxies>
	<capabilities>
		<!-- can_heat/can_cool/can_do_auto/has_single_setpoint are deprecated in
		     favor of the HVAC mode lists; declared false and driven at runtime
		     from the entity's hvac_modes. -->
		<can_heat>false</can_heat>
		<can_cool>false</can_cool>
		<can_do_auto>false</can_do_auto>
		<has_single_setpoint>false</has_single_setpoint>
		<hvac_modes>Off,Heat,Cool,Auto</hvac_modes>
		<!-- hvac_states has no runtime update path: declare the full superset -->
		<hvac_states>Off,Heat,Cool,Fan</hvac_states>
		<fan_states>Off,On</fan_states>
		<can_change_scale>true</can_change_scale>
		<has_connection_status>true</has_connection_status>
		<has_humidity>false</has_humidity>
		<has_extras>true</has_extras>
		<can_preset>false</can_preset>
		<can_preset_schedule>false</can_preset_schedule>
		<can_calibrate>false</can_calibrate>
		<has_vacation_mode>false</has_vacation_mode>
		<can_inc_dec_setpoints>false</can_inc_dec_setpoints>
		<setpoint_heat_min_c>5</setpoint_heat_min_c>
		<setpoint_heat_max_c>35</setpoint_heat_max_c>
		<setpoint_heat_min_f>41</setpoint_heat_min_f>
		<setpoint_heat_max_f>95</setpoint_heat_max_f>
		<setpoint_cool_min_c>5</setpoint_cool_min_c>
		<setpoint_cool_max_c>35</setpoint_cool_max_c>
		<setpoint_cool_min_f>41</setpoint_cool_min_f>
		<setpoint_cool_max_f>95</setpoint_cool_max_f>
		<setpoint_single_min_c>5</setpoint_single_min_c>
		<setpoint_single_max_c>35</setpoint_single_max_c>
		<setpoint_single_min_f>41</setpoint_single_min_f>
		<setpoint_single_max_f>95</setpoint_single_max_f>
		<setpoint_heat_resolution_c>0.5</setpoint_heat_resolution_c>
		<setpoint_heat_resolution_f>1</setpoint_heat_resolution_f>
		<setpoint_cool_resolution_c>0.5</setpoint_cool_resolution_c>
		<setpoint_cool_resolution_f>1</setpoint_cool_resolution_f>
		<current_temperature_resolution_c>0.5</current_temperature_resolution_c>
		<current_temperature_resolution_f>1</current_temperature_resolution_f>
		<setpoint_heatcool_deadband_c>1</setpoint_heatcool_deadband_c>
		<setpoint_heatcool_deadband_f>2</setpoint_heatcool_deadband_f>
	</capabilities>
	<config>
		<script jit="1" file="driver.lua"></script>
		<documentation file="www/documentation.txt">Represents one Home Assistant climate entity (thermostat, heat pump, AC, ...) as a Control4 thermostat. Requires the Home Assistant Gateway driver in the project; pick the entity with the Entity Selector property or type its entity_id.</documentation>
		<properties>
			<property>
				<name>Driver Version</name>
				<type>STRING</type>
				<default></default>
				<readonly>true</readonly>
			</property>
			<property>
				<name>Entity Selector</name>
				<type>DYNAMIC_LIST</type>
				<readonly>false</readonly>
				<tooltip>Pick a climate entity discovered from Home Assistant (populated while the gateway is connected)</tooltip>
			</property>
			<property>
				<name>Entity ID</name>
				<type>STRING</type>
				<default></default>
				<readonly>false</readonly>
				<tooltip>Home Assistant entity_id, e.g. climate.living_room</tooltip>
			</property>
			<property>
				<name>Climate State</name>
				<type>STRING</type>
				<default></default>
				<readonly>true</readonly>
			</property>
			<property>
				<name>HVAC Action</name>
				<type>STRING</type>
				<default></default>
				<readonly>true</readonly>
			</property>
			<property>
				<name>Current Temperature</name>
				<type>STRING</type>
				<default></default>
				<readonly>true</readonly>
			</property>
			<property>
				<name>Setpoints</name>
				<type>STRING</type>
				<default></default>
				<readonly>true</readonly>
			</property>
			<property>
				<name>HVAC Modes</name>
				<type>STRING</type>
				<default></default>
				<readonly>true</readonly>
			</property>
			<property>
				<name>Debug Mode</name>
				<type>LIST</type>
				<items>
					<item>Off</item>
					<item>On</item>
				</items>
				<default>Off</default>
				<readonly>false</readonly>
			</property>
		</properties>
